# IBM watsonx.ai Configuration
# Get your API key from: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your_watsonx_api_key_here

# Optional: Custom watsonx API URL (default: https://us-south.ml.cloud.ibm.com)
WATSONX_API_URL=https://us-south.ml.cloud.ibm.com

# Optional: watsonx Project ID
WATSONX_PROJECT_ID=your_project_id_here

# Perplexity API — grounded web search for company research
# Get your API key from: https://www.perplexity.ai/settings/api
# Optional: if absent, company-research endpoint returns "" and generation still works.
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Server Configuration
NODE_ENV=development
PORT=3001

# CORS Configuration (optional)
# CORS_ORIGIN=http://localhost:5173
